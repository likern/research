{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pinega.example/schemas/web-content-index.schema.json",
  "title": "Pinega Web multilingual content index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "site", "entries"],
  "properties": {
    "schema_version": { "const": 3 },
    "site": { "$ref": "#/$defs/site" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "organization", "tagline", "default_locale", "locales"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "organization": { "type": "string", "minLength": 1 },
        "tagline": { "type": "string", "minLength": 1 },
        "default_locale": { "type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Z][a-z]{3})?(?:-[A-Z]{2}|-[0-9]{3})?$" },
        "locales": {
          "type": "object",
          "minProperties": 2,
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z]{2,3}(?:-[A-Z][a-z]{3})?(?:-[A-Z]{2}|-[0-9]{3})?$": { "$ref": "#/$defs/site_locale" }
          }
        }
      }
    },
    "site_locale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lang", "format_locale", "path_prefix", "direction", "label", "og_locale", "summary", "primary_navigation"],
      "properties": {
        "lang": { "type": "string", "minLength": 2 },
        "format_locale": { "type": "string", "minLength": 2 },
        "path_prefix": { "type": "string", "pattern": "^$|^/[a-z0-9-]+$" },
        "direction": { "enum": ["ltr", "rtl"] },
        "label": { "type": "string", "minLength": 1 },
        "og_locale": { "type": "string", "pattern": "^[a-z]{2,3}_[A-Z]{2}$" },
        "summary": { "type": "string", "minLength": 1 },
        "primary_navigation": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/navigation_item" }
        }
      }
    },
    "navigation_item": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "entry_id"],
          "properties": {
            "label": { "type": "string", "minLength": 1 },
            "entry_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "href", "external"],
          "properties": {
            "label": { "type": "string", "minLength": 1 },
            "href": { "type": "string", "format": "uri" },
            "external": { "const": true }
          }
        }
      ]
    },
    "documentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section", "purpose", "order", "related"],
      "properties": {
        "section": { "enum": ["landing", "start", "tutorials", "how-to", "concepts", "reference", "contributing"] },
        "purpose": { "enum": ["index", "start", "tutorial", "how-to", "explanation", "reference", "contributing"] },
        "order": { "type": "integer", "minimum": 0 },
        "related": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
        }
      }
    },
    "localized_documentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applies_to"],
      "properties": {
        "applies_to": { "type": "string", "minLength": 1 }
      }
    },
    "localized_page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status", "route", "source_path", "output_path", "canonical_title", "navigation_title", "summary",
        "updated_at", "reviewed_revision", "sitemap", "searchable", "structured_data_type", "canonical"
      ],
      "properties": {
        "status": { "const": "published" },
        "route": { "type": "string", "pattern": "^/" },
        "source_path": { "type": "string", "minLength": 1 },
        "output_path": { "type": "string", "minLength": 1 },
        "canonical_title": { "type": "string", "minLength": 1 },
        "navigation_title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "updated_at": { "type": "string", "format": "date" },
        "reviewed_revision": { "type": "integer", "minimum": 1 },
        "sitemap": { "type": "boolean" },
        "searchable": { "type": "boolean" },
        "structured_data_type": { "type": ["string", "null"] },
        "canonical": { "type": "boolean" },
        "documentation": { "$ref": "#/$defs/localized_documentation" }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "content_type", "audience", "programme", "research_area", "topics", "maturity_status",
        "published_at", "authors", "public", "revision", "locales"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "content_type": { "type": "string", "minLength": 1 },
        "audience": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "programme": { "type": "string", "minLength": 1 },
        "research_area": { "type": ["string", "null"] },
        "topics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "maturity_status": { "type": "string", "minLength": 1 },
        "published_at": { "type": ["string", "null"], "format": "date" },
        "authors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "public": { "type": "boolean" },
        "revision": { "type": "integer", "minimum": 1 },
        "documentation": { "$ref": "#/$defs/documentation" },
        "locales": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z]{2,3}(?:-[A-Z][a-z]{3})?(?:-[A-Z]{2}|-[0-9]{3})?$": { "$ref": "#/$defs/localized_page" }
          }
        }
      }
    }
  }
}
