{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pinega.example/schemas/accessibility-tree-coverage.schema.json",
  "title": "Pinega Web accessibility-tree coverage registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "kind",
    "policy",
    "profiles",
    "dom_only_properties",
    "semantic_equivalence",
    "requirements"
  ],
  "properties": {
    "$schema": { "const": "./coverage.schema.json" },
    "schema_version": { "const": 2 },
    "kind": { "const": "pinega-web-accessibility-tree-coverage" },
    "policy": { "$ref": "#/$defs/policy" },
    "profiles": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/profile" }
    },
    "dom_only_properties": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/domOnlyProperty" }
    },
    "semantic_equivalence": { "$ref": "#/$defs/semanticEquivalence" },
    "requirements": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/requirement" }
    }
  },
  "$defs": {
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "profileId": {
      "enum": [
        "chromium-desktop",
        "chromium-mobile",
        "firefox-desktop",
        "webkit-desktop"
      ]
    },
    "serializerCase": {
      "enum": [
        "heading-levels",
        "nested-button-name",
        "hidden-svg",
        "status",
        "alert",
        "expanded",
        "pressed",
        "invalid"
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_children",
        "snapshot_path_template",
        "canonical_update_project",
        "required_profiles",
        "required_serializer_cases"
      ],
      "properties": {
        "default_children": { "const": "deep-equal" },
        "snapshot_path_template": {
          "const": "tests/accessibility/snapshots/{testFilePath}/{arg}{ext}"
        },
        "canonical_update_project": { "const": "chromium-desktop" },
        "required_profiles": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/profileId" }
        },
        "required_serializer_cases": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/serializerCase" }
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "engine", "form_factor"],
      "properties": {
        "id": { "$ref": "#/$defs/profileId" },
        "engine": { "enum": ["chromium", "firefox", "webkit"] },
        "form_factor": { "enum": ["desktop", "mobile"] }
      }
    },
    "domOnlyProperty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "property", "selector", "assertion", "reason", "test", "test_title"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^DOM-ONLY-[A-Z0-9-]+$"
        },
        "property": { "type": "string", "minLength": 1 },
        "selector": { "type": "string", "minLength": 1 },
        "assertion": {
          "enum": [
            "attribute",
            "idref",
            "focus",
            "document-locale"
          ]
        },
        "reason": { "type": "string", "minLength": 20 },
        "test": { "$ref": "#/$defs/repositoryPath" },
        "test_title": { "type": "string", "minLength": 10 }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initial_state", "action", "expected_state"],
      "properties": {
        "initial_state": { "const": "fixture-loaded" },
        "action": { "const": "none" },
        "expected_state": { "type": "string", "minLength": 10 }
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "children",
        "baseline_scope",
        "test",
        "test_title",
        "snapshot"
      ],
      "properties": {
        "type": { "const": "strict-baseline" },
        "children": { "const": "deep-equal" },
        "baseline_scope": { "const": "shared" },
        "test": { "$ref": "#/$defs/repositoryPath" },
        "test_title": { "type": "string", "minLength": 10 },
        "snapshot": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*\\.aria\\.yml$"
        }
      }
    },
    "profileMatrix": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/profileId" }
    },
    "failureAttachments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "actual", "reference", "content_type"],
      "properties": {
        "policy": { "const": "failure-only" },
        "actual": { "const": "required" },
        "reference": { "const": "required" },
        "content_type": { "const": "application/yaml" }
      }
    },
    "registeredTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "selector", "applies_to", "reason", "owner"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^TRANSITION-[A-Z0-9-]+$"
        },
        "selector": { "type": "string", "minLength": 2 },
        "applies_to": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["temporal", "navigation"] }
        },
        "reason": { "type": "string", "minLength": 30 },
        "owner": { "const": "PR 3 — interactive component states" }
      }
    },
    "temporalRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "route", "locale"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "route": {
          "type": "string",
          "pattern": "^/(?:[a-z0-9-]+/)*$"
        },
        "locale": { "enum": ["en", "ru"] }
      }
    },
    "temporalComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "candidate"],
      "properties": {
        "reference": {
          "enum": [
            "initial-authored",
            "reload-authored",
            "initial-ready"
          ]
        },
        "candidate": {
          "enum": [
            "initial-shell",
            "initial-ready",
            "reload-authored",
            "reload-shell",
            "reload-ready"
          ]
        }
      }
    },
    "temporalEquivalence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "test",
        "test_title_template",
        "projection",
        "profiles",
        "routes",
        "phases",
        "comparisons"
      ],
      "properties": {
        "test": { "$ref": "#/$defs/repositoryPath" },
        "test_title_template": { "type": "string", "minLength": 20 },
        "projection": { "const": "body-outside-registered-transitions" },
        "profiles": { "$ref": "#/$defs/profileMatrix" },
        "routes": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/temporalRoute" }
        },
        "phases": {
          "const": [
            "initial-authored",
            "initial-shell",
            "initial-ready",
            "reload-authored",
            "reload-shell",
            "reload-ready"
          ]
        },
        "comparisons": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/temporalComparison" }
        }
      }
    },
    "nativeRouteExclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "route", "content_type", "reason"],
      "properties": {
        "id": { "enum": ["component-lab", "not-found"] },
        "route": { "enum": ["/component-lab/", "/404.html"] },
        "content_type": { "enum": ["internal-validation", "system"] },
        "reason": { "type": "string", "minLength": 30 }
      }
    },
    "transactionState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "test_title", "invariant"],
      "properties": {
        "id": { "enum": ["pending", "commit", "cancel", "supersession"] },
        "test_title": { "type": "string", "minLength": 15 },
        "invariant": { "type": "string", "minLength": 30 }
      }
    },
    "navigationEquivalence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "test",
        "archetype_fixture",
        "test_title_template",
        "native_test_title_template",
        "projection",
        "profiles",
        "native_route_exclusions",
        "transaction_states"
      ],
      "properties": {
        "test": { "$ref": "#/$defs/repositoryPath" },
        "archetype_fixture": { "$ref": "#/$defs/repositoryPath" },
        "test_title_template": { "type": "string", "minLength": 20 },
        "native_test_title_template": { "type": "string", "minLength": 20 },
        "projection": { "const": "body-outside-registered-transitions" },
        "profiles": { "$ref": "#/$defs/profileMatrix" },
        "native_route_exclusions": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nativeRouteExclusion" }
        },
        "transaction_states": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/transactionState" }
        }
      }
    },
    "semanticEquivalence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "oracle",
        "failure_attachments",
        "registered_transitions",
        "temporal",
        "navigation"
      ],
      "properties": {
        "oracle": { "const": "exact-yaml-equivalence" },
        "failure_attachments": { "$ref": "#/$defs/failureAttachments" },
        "registered_transitions": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/registeredTransition" }
        },
        "temporal": { "$ref": "#/$defs/temporalEquivalence" },
        "navigation": { "$ref": "#/$defs/navigationEquivalence" }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "surface",
        "case",
        "scenario",
        "fixture",
        "locale",
        "profiles",
        "oracle",
        "supplemental_dom_assertions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ARIA-SERIALIZER-[A-Z0-9-]+$"
        },
        "status": { "const": "required" },
        "surface": { "const": "serializer-conformance" },
        "case": { "$ref": "#/$defs/serializerCase" },
        "scenario": { "$ref": "#/$defs/scenario" },
        "fixture": { "$ref": "#/$defs/repositoryPath" },
        "locale": { "const": "en" },
        "profiles": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/profileId" }
        },
        "oracle": { "$ref": "#/$defs/oracle" },
        "supplemental_dom_assertions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^DOM-ONLY-[A-Z0-9-]+$"
          }
        }
      }
    }
  }
}
