{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pinega.example/schemas/accessibility-tree-coverage.schema.json",
  "title": "Pinega Web accessibility-tree coverage registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "kind",
    "policy",
    "profiles",
    "dom_only_properties",
    "requirements"
  ],
  "properties": {
    "$schema": { "const": "./coverage.schema.json" },
    "schema_version": { "const": 1 },
    "kind": { "const": "pinega-web-accessibility-tree-coverage" },
    "policy": { "$ref": "#/$defs/policy" },
    "profiles": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/profile" }
    },
    "dom_only_properties": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/domOnlyProperty" }
    },
    "requirements": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/requirement" }
    }
  },
  "$defs": {
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "profileId": {
      "enum": [
        "chromium-desktop",
        "chromium-mobile",
        "firefox-desktop",
        "webkit-desktop"
      ]
    },
    "serializerCase": {
      "enum": [
        "heading-levels",
        "nested-button-name",
        "hidden-svg",
        "status",
        "alert",
        "expanded",
        "pressed",
        "invalid"
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_children",
        "snapshot_path_template",
        "canonical_update_project",
        "required_profiles",
        "required_serializer_cases"
      ],
      "properties": {
        "default_children": { "const": "deep-equal" },
        "snapshot_path_template": {
          "const": "tests/accessibility/snapshots/{testFilePath}/{arg}{ext}"
        },
        "canonical_update_project": { "const": "chromium-desktop" },
        "required_profiles": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/profileId" }
        },
        "required_serializer_cases": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/serializerCase" }
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "engine", "form_factor"],
      "properties": {
        "id": { "$ref": "#/$defs/profileId" },
        "engine": { "enum": ["chromium", "firefox", "webkit"] },
        "form_factor": { "enum": ["desktop", "mobile"] }
      }
    },
    "domOnlyProperty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "property", "selector", "assertion", "reason", "test", "test_title"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^DOM-ONLY-[A-Z0-9-]+$"
        },
        "property": { "type": "string", "minLength": 1 },
        "selector": { "type": "string", "minLength": 1 },
        "assertion": {
          "enum": [
            "attribute",
            "idref",
            "focus",
            "document-locale"
          ]
        },
        "reason": { "type": "string", "minLength": 20 },
        "test": { "$ref": "#/$defs/repositoryPath" },
        "test_title": { "type": "string", "minLength": 10 }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initial_state", "action", "expected_state"],
      "properties": {
        "initial_state": { "const": "fixture-loaded" },
        "action": { "const": "none" },
        "expected_state": { "type": "string", "minLength": 10 }
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "children",
        "baseline_scope",
        "test",
        "test_title",
        "snapshot"
      ],
      "properties": {
        "type": { "const": "strict-baseline" },
        "children": { "const": "deep-equal" },
        "baseline_scope": { "const": "shared" },
        "test": { "$ref": "#/$defs/repositoryPath" },
        "test_title": { "type": "string", "minLength": 10 },
        "snapshot": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*\\.aria\\.yml$"
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "surface",
        "case",
        "scenario",
        "fixture",
        "locale",
        "profiles",
        "oracle",
        "supplemental_dom_assertions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ARIA-SERIALIZER-[A-Z0-9-]+$"
        },
        "status": { "const": "required" },
        "surface": { "const": "serializer-conformance" },
        "case": { "$ref": "#/$defs/serializerCase" },
        "scenario": { "$ref": "#/$defs/scenario" },
        "fixture": { "$ref": "#/$defs/repositoryPath" },
        "locale": { "const": "en" },
        "profiles": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/profileId" }
        },
        "oracle": { "$ref": "#/$defs/oracle" },
        "supplemental_dom_assertions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^DOM-ONLY-[A-Z0-9-]+$"
          }
        }
      }
    }
  }
}
