{
  "name": "@pinega/web-foundation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Production Web Components foundation for the Pinega Strata design system.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "tokens": "node ../design/scripts/build-tokens.mjs",
    "tokens:check": "node ../design/scripts/build-tokens.mjs --check",
    "build": "node scripts/build.mjs",
    "serve": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test ../design/tests/*.test.mjs tests/unit/*.test.mjs",
    "test:browser": "playwright test tests/browser",
    "test:visual": "playwright test tests/visual --project=chromium-desktop",
    "test": "npm run tokens:check && npm run typecheck && npm run test:unit && npm run build && npm run test:browser && npm run test:visual"
  },
  "dependencies": {
    "@awesome.me/webawesome": "3.10.0"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "@types/node": "22.10.2",
    "axe-core": "4.11.4",
    "esbuild": "0.25.11",
    "typescript": "5.9.3"
  }
}
