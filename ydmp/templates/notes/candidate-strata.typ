// Candidate Strata: brand-integrated long-form research layout.
//
// Strata is experimental and intentionally does not replace Candidates A-D.
// It adds Pinega's layered visual grammar while preserving the YDMP document
// contract: long-form readability, explicit provenance, print usability, and
// clean reflow when learner annotations are omitted.

#let theme = (
  id: "candidate-strata",
  label: "Candidate Strata",
  profile: "strata",
  page_margin: (top: 18mm, bottom: 20mm, left: 20mm, right: 20mm),
  page_fill: rgb("#fbf7ef"),
  body_font: "Libertinus Serif",
  heading_font: "DejaVu Sans",
  mono_font: "DejaVu Sans Mono",
  body_size: 10.6pt,
  body_weight: "regular",
  title_size: 21.5pt,
  subtitle_size: 10.8pt,
  h1_size: 15pt,
  h2_size: 11.8pt,
  heading_weight: "bold",
  leading: 0.74em,
  paragraph_spacing: 0.60em,
  section_above: 1.32em,
  section_below: 0.62em,
  panel_inset: 8.5pt,
  panel_radius: 4pt,
  accent: rgb("#365e72"),
  accent_secondary: rgb("#b45c3f"),
  accent_tertiary: rgb("#687b59"),
  text_fill: rgb("#272827"),
  muted: rgb("#67625b"),
  rule: rgb("#c9bead"),
  panel_fill: rgb("#f4ebdd"),
  metadata_fill: rgb("#f1e8d9"),
  justify: true,
)
