{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PreparationPacket",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "paper_id",
    "input",
    "paper",
    "curriculum",
    "prepare",
    "verification"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "paper_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "input": {
      "type": "object",
      "required": ["kind", "original"],
      "properties": {
        "kind": {"enum": ["doi", "arxiv_id", "url", "title", "bibtex", "uploaded_pdf"]},
        "original": {"type": "string"},
        "pdf_sha256": {"type": ["string", "null"]}
      }
    },
    "paper": {
      "type": "object",
      "required": ["canonical_title", "authors", "publication", "identifiers", "versions", "authoritative_sources", "abstract"],
      "properties": {
        "canonical_title": {"type": "string", "minLength": 1},
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": {"type": "string"},
              "affiliation": {"type": ["string", "null"]},
              "orcid": {"type": ["string", "null"]}
            }
          }
        },
        "publication": {"type": "object"},
        "identifiers": {"type": "object"},
        "versions": {
          "type": "object",
          "required": ["selected_version", "selection_rationale", "available_versions"]
        },
        "authoritative_sources": {"type": "array", "minItems": 1},
        "abstract": {"type": ["string", "null"]}
      }
    },
    "curriculum": {
      "type": "object",
      "required": ["curriculum_id", "stage", "position", "prerequisites", "why_now"]
    },
    "prepare": {
      "type": "object",
      "required": ["expected_problem", "expected_contribution", "reading_scope", "potentially_unknown_terms", "pre_reading_questions", "comparison_targets", "ydb_mapping_hypotheses"]
    },
    "verification": {
      "type": "object",
      "required": ["metadata_conflicts", "unresolved_questions", "confidence", "validated_at", "schema_valid"],
      "properties": {
        "confidence": {"enum": ["high", "medium", "low"]},
        "schema_valid": {"const": true}
      }
    }
  }
}
